{
	"manifest_version": 3,
	"name": "assist criteria outliner",
	"version": "1.0.0",
	"description": "Adds an Outline criteria toggle to GitHub's issue editor, backed by assist's acceptance criteria outliner, and an assist button that starts a session from a GitHub comment.",
	"browser_specific_settings": {
		"gecko": {
			"id": "criteria-outliner@staff0rd.github.io",
			"strict_min_version": "109.0",
			"update_url": "https://raw.githubusercontent.com/staff0rd/assist/main/criteria-extension/updates.json"
		}
	},
	"icons": {
		"16": "icons/assist-16.png",
		"32": "icons/assist-32.png",
		"128": "icons/assist-128.png"
	},
	"web_accessible_resources": [
		{
			"resources": ["icons/assist-32.png"],
			"matches": ["https://github.com/*"]
		}
	],
	"permissions": ["storage"],
	"host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
	"options_ui": {
		"page": "options.html"
	},
	"background": {
		"scripts": ["background.js"]
	},
	"content_scripts": [
		{
			"matches": ["https://github.com/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	]
}
