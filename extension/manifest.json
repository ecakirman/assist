{
	"manifest_version": 3,
	"name": "assist",
	"version": "1.0.0",
	"description": "Brings assist to GitHub: an Outline criteria toggle that edits an issue's acceptance criteria as an outline, and an assist button that sends a comment, PR or issue to assist to start a session, plus feedback on selected text in a local assist docs preview.",
	"browser_specific_settings": {
		"gecko": {
			"id": "assist@staff0rd.github.io",
			"strict_min_version": "109.0",
			"update_url": "https://raw.githubusercontent.com/staff0rd/assist/main/extension/updates.json"
		}
	},
	"icons": {
		"16": "icons/assist-16.png",
		"32": "icons/assist-32.png",
		"128": "icons/assist-128.png"
	},
	"web_accessible_resources": [
		{
			"resources": ["icons/assist-32.png"],
			"matches": [
				"https://github.com/*",
				"http://localhost/*",
				"http://127.0.0.1/*"
			]
		}
	],
	"permissions": ["storage"],
	"host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
	"options_ui": {
		"page": "options.html"
	},
	"background": {
		"scripts": ["background.js"]
	},
	"content_scripts": [
		{
			"matches": ["https://github.com/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		},
		{
			"matches": ["http://localhost/*", "http://127.0.0.1/*"],
			"js": ["docs.js"],
			"run_at": "document_idle"
		}
	]
}
